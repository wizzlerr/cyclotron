    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@cyclotron/core": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "@types/web-bluetooth": "^0.0.21",
    "electron": "^44.9.3",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "electron-vite": "^6.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "three": "0.186.1",
    "typescript": "~6.0.3",
    "uplot": "1.6.32",
    "vite": "^8.3.4"
  }
