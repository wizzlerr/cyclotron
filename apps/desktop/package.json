{
  "name": "@cyclotron/desktop",
  "productName": "Cyclotron",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Indoor cycling trainer",
  "author": "adam.sabel",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
